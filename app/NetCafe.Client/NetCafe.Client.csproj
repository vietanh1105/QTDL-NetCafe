<!-- Station customer app; links directly to NetCafe.Data and PostgreSQL function contract. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NetCafe.Data\NetCafe.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\Products\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
