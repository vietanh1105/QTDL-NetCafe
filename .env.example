# Cấu hình kết nối Cơ sở dữ liệu PostgreSQL cho NetCafe DB (Neon Cloud)
DB_HOST=ep-blue-cherry-b8mrp18t.c-14.us-east-1.aws.neon.tech
DB_PORT=5432
DB_USER=nv_admin
DB_PASSWORD=
DB_OWNER_USER=postgres
